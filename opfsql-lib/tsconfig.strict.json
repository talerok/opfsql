{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/errors.ts",
    "src/values",
    "src/functions",
    "src/schema",
    "src/storage",
    "src/table",
    "src/sql/parser",
    "src/sql/plan",
    "src/expressions",
    "src/executor",
    "src/legacy/executor/evaluate",
    "src/engine/api",
    "src/worker",
    "test/support"
  ],
  "exclude": ["src/worker/tests"]
}
