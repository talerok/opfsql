{
  "name": "opfsql",
  "version": "0.0.2",
  "description": "Lightweight SQL engine in TypeScript. ~40 KB gzipped, zero native deps. Runs in browser workers via OPFS.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config test/e2e/infra/config.ts",
    "bench": "node --expose-gc ./node_modules/vite-node/vite-node.mjs bench/node.ts --",
    "bench:browser": "vite-node bench/browser.ts --",
    "build": "cp ../README.md ./README.md && cp ../LICENSE ./LICENSE && esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --external:cbor-x --minify && tsc --emitDeclarationOnly --outDir dist"
  },
  "keywords": [
    "sql",
    "opfs",
    "indexeddb",
    "browser",
    "database",
    "sqlite",
    "in-browser",
    "worker",
    "typescript"
  ],
  "author": "talerok",
  "license": "MIT",
  "homepage": "https://github.com/talerok/opfsql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talerok/opfsql.git",
    "directory": "opfsql-lib"
  },
  "bugs": {
    "url": "https://github.com/talerok/opfsql/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.0",
    "opfs-mock": "^2.6.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "cbor-x": "^1.6.4"
  }
}
