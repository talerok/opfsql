{
  "name": "opfsql",
  "version": "0.0.2",
  "description": "An embedded SQL database for the browser, in TypeScript with no dependencies. Runs in a worker over OPFS.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.check.json && tsc -p tsconfig.strict.json",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config test/e2e/infra/config.ts",
    "bench": "npm run bench:bundle --silent && node --expose-gc bench/dist/node.js",
    "bench:bundle": "esbuild bench/node.ts --bundle --platform=node --format=esm --minify --sourcemap --packages=external --outfile=bench/dist/node.js --log-level=warning",
    "bench:browser": "vite-node bench/browser.ts --",
    "bench:profile": "node --expose-gc ./node_modules/vite-node/vite-node.mjs bench/profile.ts --",
    "build": "cp ../README.md ./README.md && cp ../LICENSE ./LICENSE && esbuild index=src/index.ts worker=src/worker-entry.ts --bundle --splitting --format=esm --outdir=dist --minify && tsc --emitDeclarationOnly --outDir dist"
  },
  "keywords": [
    "sql",
    "opfs",
    "indexeddb",
    "browser",
    "database",
    "sqlite",
    "in-browser",
    "worker",
    "typescript"
  ],
  "author": "talerok",
  "license": "MIT",
  "homepage": "https://github.com/talerok/opfsql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talerok/opfsql.git",
    "directory": "opfsql-lib"
  },
  "bugs": {
    "url": "https://github.com/talerok/opfsql/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "opfs-mock": "^2.6.0",
    "prettier": "3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
