# alter-table.slt — ALTER TABLE ADD COLUMN / DROP COLUMN

# ============================================================================
# Setup
# ============================================================================

statement ok
CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)

statement ok
INSERT INTO users VALUES (1, 'Alice')

statement ok
INSERT INTO users VALUES (2, 'Bob')

# ============================================================================
# ALTER TABLE ADD COLUMN
# ============================================================================

statement ok
ALTER TABLE users ADD COLUMN age INTEGER

# Existing rows should have NULL for new column
query ITI rowsort
SELECT * FROM users
----
1|Alice|NULL
2|Bob|NULL

# New inserts can use the new column
statement ok
INSERT INTO users VALUES (3, 'Charlie', 30)

query ITI rowsort
SELECT * FROM users
----
1|Alice|NULL
2|Bob|NULL
3|Charlie|30

# ============================================================================
# ALTER TABLE ADD another column
# ============================================================================

statement ok
ALTER TABLE users ADD COLUMN email TEXT

query ITIT rowsort
SELECT * FROM users
----
1|Alice|NULL|NULL
2|Bob|NULL|NULL
3|Charlie|30|NULL

statement ok
UPDATE users SET email = 'alice@test.com' WHERE id = 1

query TT nosort
SELECT name, email FROM users WHERE id = 1
----
Alice|alice@test.com

# ============================================================================
# ALTER TABLE DROP COLUMN
# ============================================================================

statement ok
ALTER TABLE users DROP COLUMN email

# email column should no longer exist
query ITI rowsort
SELECT * FROM users
----
1|Alice|NULL
2|Bob|NULL
3|Charlie|30

# ============================================================================
# ADD COLUMN with DEFAULT: existing rows read the default
# ============================================================================

statement ok
CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT)

statement ok
INSERT INTO items VALUES (1, 'a'), (2, 'b')

statement ok
ALTER TABLE items ADD COLUMN qty INTEGER DEFAULT 5

statement ok
INSERT INTO items (id, name, qty) VALUES (3, 'c', 7)

query ITI nosort
SELECT id, name, qty FROM items ORDER BY id
----
1|a|5
2|b|5
3|c|7

# ============================================================================
# DROP COLUMN keeps every other column, and a re-added column starts empty
# ============================================================================

statement ok
ALTER TABLE items DROP COLUMN name

query II nosort
SELECT * FROM items ORDER BY id
----
1|5
2|5
3|7

statement ok
ALTER TABLE items ADD COLUMN name TEXT

query IIT nosort
SELECT * FROM items ORDER BY id
----
1|5|NULL
2|5|NULL
3|7|NULL

statement ok
DROP TABLE items

# ============================================================================
# ALTER TABLE on non-existent table
# ============================================================================

statement error
ALTER TABLE nonexistent ADD COLUMN foo INTEGER

# ============================================================================
# Cleanup
# ============================================================================

statement ok
DROP TABLE users
